{
  "name": "vectra",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first browser vectorization and artistic print studio (P0 feasibility workbench)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vp dev",
    "check": "vp check",
    "test": "vp test",
    "test:rust": "cargo test --locked --workspace",
    "build": "node scripts/build-wasm.mjs && vp build && node scripts/generate-notices.mjs --check && node scripts/generate-sw.mjs && node scripts/check-dist.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "preview": "vp preview --port 4173 --strictPort",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@base-ui/utils": "0.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    }
  }
}
